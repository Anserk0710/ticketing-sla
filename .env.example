POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing_sla

# Digunakan saat menjalankan API langsung di host, bukan di Docker.
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5433/ticketing_sla?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_ISSUER=ticketing-sla-api
JWT_AUDIENCE=ticketing-sla-web

# Port host aplikasi. PostgreSQL Compose utama tidak diekspos ke host.
# POSTGRES_HOST_PORT hanya dipakai oleh docker-compose.local.yml.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
WEB_HOST_PORT=8080

PUBLIC_WEB_URL=http://localhost:8080
VITE_API_URL=http://localhost:3000/api/v1
DATABASE_BOOTSTRAP_RETRIES=30
DATABASE_BOOTSTRAP_DELAY_SECONDS=2
