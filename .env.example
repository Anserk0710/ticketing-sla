POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing_sla

# Digunakan saat menjalankan API langsung di host, bukan di Docker.
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5433/ticketing_sla?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
JWT_ISSUER=ticketing-sla-api
JWT_AUDIENCE=ticketing-sla-web

# Image names for Docker Compose
API_IMAGE=ticketing-sla-api:latest
WEB_IMAGE=ticketing-sla-web:latest

# Port host aplikasi. PostgreSQL Compose utama tidak diekspos ke host.
# POSTGRES_HOST_PORT hanya dipakai oleh docker-compose.local.yml.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
WEB_HTTP_PORT=80
WEB_HOST_PORT=443

# --- LAN HOSTNAME ---
# Arahkan hostname lokal ke IP server melalui DNS lokal/router.
# Demo: ticketing-demo.test
# Development: ticketing-dev.test
# Jika IP server berubah, update DNS lokal saja. Source dan image tetap sama.
PUBLIC_WEB_URL=https://ticketing-demo.test,https://localhost
EMAIL_WEB_BASE_URL=https://sla.example.com
VITE_API_URL=/api/v1
TLS_CERT_FILE=./runtime/certs/demo/server-cert.pem
TLS_KEY_FILE=./runtime/certs/demo/server-key.pem

# SMTP Configuration
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=Ticketing SLA <it@example.com>

SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000

DATABASE_BOOTSTRAP_RETRIES=30
DATABASE_BOOTSTRAP_DELAY_SECONDS=2
