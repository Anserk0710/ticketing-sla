NODE_ENV=development
PORT=3000

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

PUBLIC_WEB_URL=http://localhost:5173
EMAIL_WEB_BASE_URL=http://localhost:5173

MEDIA_STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=uploads

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

SLA_SCHEDULER_MODE=INTERNAL

SLA_INTERNAL_INTERVAL_MS=60000

SLA_CRON_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000

# =========================================================
# Observability / Hardening
# =========================================================

SWAGGER_ENABLED=true

# Request >= 1500 ms ditandai sebagai slow request.
SLOW_REQUEST_THRESHOLD_MS=1500