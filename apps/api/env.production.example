# =========================================================
# Ticketing SLA - Production Infrastructure
# Copy menjadi .env.production.local untuk setup/testing lokal.
# JANGAN commit .env.production.local.
# =========================================================

APP_ENV=PRODUCTION
NODE_ENV=production
PORT=3000

# Neon PostgreSQL
# Runtime API menggunakan pooled hostname "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Migration/admin tooling menggunakan direct/non-pooler hostname.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_ACCESS_SECRET=replace-with-random-secret-minimum-32-characters
JWT_REFRESH_SECRET=replace-with-different-random-secret-minimum-32-characters
JWT_ISSUER=ticketing-sla-api
JWT_AUDIENCE=ticketing-sla-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Ganti ketika URL Frontend production sudah tersedia.
PUBLIC_WEB_URL=https://your-frontend.vercel.app
EMAIL_WEB_BASE_URL=https://your-frontend.vercel.app

MEDIA_STORAGE_PROVIDER=VERCEL_BLOB
UPLOAD_DIR=uploads

# Private Vercel Blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Production SLA scheduler
SLA_SCHEDULER_MODE=EXTERNAL
SLA_INTERNAL_INTERVAL_MS=60000
SLA_CRON_SECRET=replace-with-random-secret-minimum-32-characters

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Ticketing SLA <no-reply@example.com>"
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000

# Hanya untuk infra verification.
SMTP_TEST_TO=your-email@example.com

# Hanya digunakan pada first production seed.
# Setelah berhasil, hapus bootstrap password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-temporary-password-minimum-12-characters
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_PHONE=