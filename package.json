{
  "name": "ticketing-sla",
  "version": "1.1.0",
  "private": true,
  "description": "Sistem Ticketing, Field Service, SLA Respond dan SLA Pengerjaan",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preflight": "node scripts/validate-workspaces.mjs",
    "dev": "concurrently -n api,web -c auto \"npm run dev -w @ticketing/api\" \"npm run dev -w @ticketing/web\"",
    "build": "npm run build -w @ticketing/contracts && npm run build -w @ticketing/api && npm run build -w @ticketing/web",
    "test": "npm run test -w @ticketing/api && npm run test -w @ticketing/web",
    "lint": "npm run lint -w @ticketing/api && npm run lint -w @ticketing/web",
    "format": "prettier --write .",
    "db:generate": "npm run prisma:generate -w @ticketing/api",
    "db:migrate": "npm run prisma:migrate -w @ticketing/api",
    "db:deploy": "npm run prisma:deploy -w @ticketing/api",
    "db:deploy:production": "npm run prisma:deploy:production -w @ticketing/api",
    "db:seed": "npm run prisma:seed -w @ticketing/api",
    "db:seed:production": "npm run prisma:seed:production -w @ticketing/api",
    "db:studio": "node --env-file=.env node_modules/prisma/build/index.js studio --schema apps/api/prisma/schema.prisma --hostname 127.0.0.1 --port 5555 --browser none",
    "db:push": "npm run prisma:push -w @ticketing/api",
    "infra:verify:production": "npm run infra:verify:production -w @ticketing/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "vercel": "^59.7.0"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}